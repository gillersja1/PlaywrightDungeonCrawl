{
  "stryker-config": {
    "project": "PlaywrightDungeonCrawl.csproj",
    "test-projects": [ "PlaywrightDungeonCrawl.Tests.csproj" ],
    "mutate": [
      "**/Dungeon/CertificateRules.cs",
      "**/Dungeon/Curses.cs",
      "**/Dungeon/Leaderboard.cs",
      "**/Dungeon/Shop.cs",
