@page "/floors/{slug}"
@model PlaywrightDungeonCrawl.Pages.Floors.LessonModel
@{
    ViewData["Title"] = $"{Model.Floor.Title}: scroll";
}

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Respawn Room</a> › Floor @Model.Floor.Number</nav>

<section class="panel sealed-note" data-sealed-note hidden>
    <h2><span aria-hidden="true">🔒</span> This floor is sealed</h2>
    <p>Finish floor @(Model.Floor.Number - 1) first. The map in the Respawn Room shows what's left.</p>
    <a class="button" href="/">Back to the Respawn Room</a>
</section>
<div data-page-gate="@Model.Floor.Number">
<article class="scroll" aria-labelledby="lesson-title">
    <p class="eyebrow">Floor @Model.Floor.Number · @Model.Floor.Skill</p>
    <h1 id="lesson-title">@Model.Floor.Title</h1>
    <p class="lead">@Model.Floor.Tagline</p>
    <partial name="_DungeonAi" model="PlaywrightDungeonCrawl.Dungeon.DungeonAi.FloorIntro(Model.Floor.Slug)" />

    <partial name="_TypeScriptComingSoon" model="Model.Floor" />
    @if (Model.Floor.For(PlaywrightDungeonCrawl.Dungeon.Languages.Current(Context)) == PlaywrightDungeonCrawl.Dungeon.CodeLanguage.TypeScript)
    {
        <partial name="Lessons/_@(Model.Floor.Slug)-ts" />
    }
    else
    {
        <partial name="Lessons/_@Model.Floor.Slug" />
    }

    <footer class="scroll-footer">
        <button type="button" id="mark-read" data-floor="@Model.Floor.Slug">Mark scroll as read</button>
        <a class="button secondary" href="/floors/@Model.Floor.Slug/riddle">Face the riddle →</a>
        <p id="read-result" role="status" aria-live="polite"></p>
    </footer>
    <div class="next-step" data-next-step="@Model.Floor.Number" data-next-after="scrolls" hidden></div>
</article>
</div>

@section Scripts {
    <script>
        document.getElementById("mark-read").addEventListener("click", e => {
            const isNew = Dungeon.mark("scrolls", e.currentTarget.dataset.floor);
            document.getElementById("read-result").textContent = isNew
                ? `Scroll read. +${Dungeon.rules.scroll} XP`
                : "You've already read this scroll.";
        });
    </script>
}
