@page
@model CertificateModel
@using PlaywrightDungeonCrawl.Dungeon
@{
    ViewData["Title"] = "Your certificates";
}

<section class="hero">
    <p class="eyebrow">Playwright Dungeon Crawl</p>
    <h1>The certificate path</h1>
    <p class="lead">
        Clear the dungeon and it will vouch for you in writing. There are three tiers, each a @CertificateRules.Title with
        its own page anyone can check, ready for your LinkedIn profile.
    </p>
</section>

@if (Model.Mine is null)
{
    <section class="panel">
        <p>Certificates are for signed-in crawlers, so the dungeon knows whose name it's vouching for.
            <a href="/signin?returnUrl=/certificate">Sign in with GitHub</a> to start.</p>
    </section>
}
else
{
    <p class="breakdown">
        Verified so far: <strong>@Model.Mine.FloorsCleared of @Model.FloorCount floors</strong> cleared. A floor counts once
        its riddle is answered and its treasure is claimed while you're signed in.
    </p>
}

<ol class="cert-path">
    @foreach (var tier in CertificateRules.Tiers)
    {
        var state = Model.StateOf(tier);
        Model.Earned.TryGetValue(tier.Tier, out var earned);
        <li class="panel cert-tier @state.ToString().ToLowerInvariant()" aria-labelledby="tier-@tier.Code">
            <p class="station">Floors 1–@tier.Floors · @tier.Reach</p>
            <h2 id="tier-@tier.Code">@tier.Name</h2>
            @switch (state)
            {
                case CertificateModel.TierState.Earned:
                    <p class="tier-state">Earned @earned!.IssuedAt.ToString("d MMMM yyyy"). <a href="/certificates/@earned.Id">View your certificate</a>.</p>
                    <details>
                        <summary>Change the name or language</summary>
                        <p>It stays at the same address with the same date.</p>
                        <partial name="_CertificateForm" model="(Model, tier, true)" />
                    </details>
                    break;
                case CertificateModel.TierState.Ready:
                    <p class="tier-state">All @tier.Floors floors verified. You've earned it: choose the name to print.</p>
                    <partial name="_CertificateForm" model="(Model, tier, false)" />
                    break;
                case CertificateModel.TierState.Locked:
                    <p class="tier-state">Not yet. Clear floors 1 to @tier.Floors to earn it.</p>
                    break;
                default:
                    <p class="tier-state">Sealed. Floors @(Model.FloorCount + 1)–@tier.Floors are still being dug; this tier opens when they are.</p>
                    break;
            }
            @if (Model.Error is not null && Model.ErrorTier == tier.Tier)
            {
                <p class="bad" role="alert">@Model.Error</p>
            }
        </li>
    }
</ol>

<p><a class="button secondary" href="/">Back to the map</a> <a class="button secondary" href="/leaderboard">See the leaderboard</a></p>