@page
@model IndexModel
@using PlaywrightDungeonCrawl.Dungeon
@{
    ViewData["Title"] = "The Respawn Room";
}

<section class="hero lobby">
    <p class="eyebrow">Playwright Dungeon Crawl · Learn Playwright for .NET</p>
    <h1>The Respawn Room</h1>
    <p class="lead">
        The crawlers-only lounge at the top of the stairs. Grab a seat at the bar, check the map, admire
        your trophies. Every trip into the dungeon starts here, and so does every comeback.
    </p>
    <aside class="dungeon-ai" aria-label="The Dungeon AI says">
        <p class="ai-label"><span class="ai-eye" aria-hidden="true"></span> Dungeon AI</p>
        <p class="ai-line" id="ai-greeting">The Dungeon AI is warming up. It runs on judgment, and judgment takes a moment.</p>
    </aside>
</section>

<section class="panel how-panel" aria-labelledby="how-heading">
    <h2 id="how-heading">How the crawl works</h2>
    <p>Each floor teaches one Playwright skill, in three parts. Floors open in order.</p>
    <ol class="how">
        <li><strong>Scroll</strong>: a short lesson with C# examples. <span class="xp-tag">+@Model.Rewards.Scroll XP</span></li>
        <li><strong>Riddle</strong>: three questions to check you've got it. <span class="xp-tag">+@Model.Rewards.Riddle XP</span></li>
        <li><strong>Trap room</strong>: write a Playwright test that clears it and prints a treasure flag. <span class="xp-tag">+@Model.Rewards.Treasure XP</span></li>
    </ol>
    <p class="breakdown">Stuck? Hints and nudges are there, for a few XP. Help on floor 1 is free.</p>
</section>

<section class="panel claim-bar" aria-labelledby="treasure">
    <h2 id="treasure">Claim treasure</h2>
    <p>Cleared a trap room with a script? Paste the flag it printed to hang the treasure on the wall.</p>
    <form id="claim-form" class="inline-form">
        <label for="flag-input">Flag</label>
        <input id="flag-input" name="flag" placeholder="PDC{...}" autocomplete="off" required />
        <button type="submit">Claim treasure</button>
    </form>
    <p id="claim-result" role="status" aria-live="polite"></p>
    <div class="next-step" id="claim-next" data-next-after="treasures" hidden></div>
</section>

<div class="lobby-grid">
    <section id="progress" class="panel progress-panel" aria-labelledby="progress-heading">
        <details class="rollup" data-rollup="progress">
        <summary>
            <span class="station">The Trophy Wall</span>
            <h2 id="progress-heading">Your progress</h2>
            <p class="rank-line"><span id="rank-title">Novice Delver</span> · score <span id="xp-total">0</span> / @Model.MaxXp XP</p>
            <div class="xp-bar" role="progressbar" aria-label="Experience" aria-valuemin="0" aria-valuemax="@Model.MaxXp" aria-valuenow="0">
                <div class="xp-fill"></div>
            </div>
        </summary>
        <p class="breakdown">Earned <span id="xp-earned">0</span> XP, spent <span id="xp-help">0</span> on hints and nudges.</p>
        <h3>Ranks</h3>
        <ol class="rank-ladder">
            @foreach (var (minXp, title) in Rewards.RanksFor(Model.MaxXp))
            {
                <li data-rank-xp="@minXp"><span>@title</span> <span class="breakdown">@minXp XP</span></li>
            }
        </ol>
        </details>
    </section>

    <section class="panel quartermaster" aria-labelledby="shop-heading">
        <details class="rollup" data-rollup="shop">
        <summary>
            <span class="station">The Quartermaster's Counter</span>
            <h2 id="shop-heading">Loot shop</h2>
            <p class="wallet">Wallet: <strong id="wallet">0 XP</strong> to spend. Your score stays <span id="wallet-score">0</span> XP.</p>
        </summary>
        <p>
            Titles, torches and other questionable finery, paid for from your wallet. Spending never lowers your
            score. A torch recolors the dungeon and lights it up while you wear it.
        </p>
        @foreach (var group in Shop.Items.GroupBy(i => i.Slot))
        {
            <h3>@(group.Key == LootSlot.Title ? "Titles" : "Torches")</h3>
            <ul class="loot-list">
                @foreach (var item in group)
                {
                    <li class="loot" data-loot="@item.Id" data-slot="@item.Slot.ToString().ToLowerInvariant()">
                        @if (item.Color is { } color)
                        {
                            <span class="swatch" style="--swatch: @color" aria-hidden="true"></span>
                        }
                        <span class="loot-text">
                            <strong>@item.Name</strong>
                            <span class="loot-description">@item.Description</span>
                        </span>
                        <button type="button" class="loot-button" aria-label="Buy @item.Name for @item.Price XP">@item.Price XP</button>
                    </li>
                }
            </ul>
        }
        <p id="shop-status" class="shop-status" role="status"></p>
        </details>
    </section>
</div>

<section aria-labelledby="map-heading">
    <p class="station">The Bar</p>
    <h2 id="map-heading">The dungeon map</h2>
    <ol class="floors">
        @foreach (var floor in Model.Floors)
        {
            <li class="floor-card" data-floor-gate="@floor.Number" aria-labelledby="floor-@floor.Slug-title">
                <p class="floor-number">Floor @floor.Number · @floor.Skill</p>
                <h3 id="floor-@floor.Slug-title">@floor.Title</h3>
                <p>@floor.Tagline</p>
                <p class="lock-note"><span aria-hidden="true">🔒</span> Sealed until you complete floor @(floor.Number - 1).</p>
                <ul class="steps">
                    <li data-progress="scrolls:@floor.Slug"><a href="/floors/@floor.Slug">Scroll</a> <span class="state">Not yet</span></li>
                    <li data-progress="riddles:@floor.Slug"><a href="/floors/@floor.Slug/riddle">Riddle</a> <span class="state">Not yet</span></li>
                    <li data-progress="treasures:@floor.Room.Slug"><a href="/rooms/@floor.Room.Slug">@floor.Room.Name</a> <span class="state">Not yet</span></li>
                </ul>
            </li>
        }
        @foreach (var (number, title, skill) in Model.SealedFloors)
        {
            <li class="floor-card sealed" aria-label="Floor @number, @title, sealed">
                <p class="floor-number">Floor @number · @skill</p>
                <h3><span aria-hidden="true">🔒</span> @title</h3>
                <p>The stairs down haven't been dug yet.</p>
            </li>
        }
    </ol>
    <partial name="_DungeonAi" model="DungeonAi.SealedFloors" />
</section>

<section class="panel subtle" aria-labelledby="reset-heading">
    <h2 id="reset-heading">Start over</h2>
    <p>Wipes the progress saved in this browser, and on your GitHub account if you're signed in. The Dungeon AI will pretend not to remember you.</p>
    <button type="button" id="reset-progress" class="secondary">Reset progress</button>
</section>

@section Scripts {
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/shop.js" asp-append-version="true"></script>
    <script src="~/js/rollup.js" asp-append-version="true"></script>
}
