@page "/certificates/{id}"
@model PlaywrightDungeonCrawl.Pages.Certificates.ViewModel
@using PlaywrightDungeonCrawl.Dungeon
@{
    var cert = Model.Certificate;
    var tier = CertificateRules.For(cert.Tier);
    ViewData["Title"] = $"{CertificateRules.Title} ({tier.Name}): {cert.Name}";
}

<article class="certificate" aria-label="@CertificateRules.Title">
    <p class="certificate-banner">~ Playwright Dungeon Crawl ~</p>
    <h1>@CertificateRules.Title</h1>
    <p class="certificate-tier">@tier.Name tier</p>
    <p class="certificate-intro">This certifies that</p>
    <p class="certificate-name">@cert.Name</p>
    <p>
        cleared @(cert.Floors == 1 ? "the first floor" : $"floors 1 to {cert.Floors}") of the dungeon by writing
        Playwright tests in @cert.Language.DisplayName():
    </p>
    <ul class="certificate-skills">
        @foreach (var floor in Model.Floors)
        {
            <li>@floor.Skill</li>
        }
    </ul>
    <dl class="certificate-facts">
        <div><dt>Score</dt><dd>@cert.Score.ToString("N0") XP</dd></div>
        <div><dt>Issued</dt><dd>@cert.IssuedAt.ToString("d MMMM yyyy")</dd></div>
        <div><dt>Certificate ID</dt><dd>@cert.Id</dd></div>
    </dl>
    <div class="certificate-seal" aria-hidden="true">⚔</div>
    <blockquote class="certificate-signoff">
        <p>"@DungeonAi.CertificateSignOff"</p>
        <footer>The Dungeon AI</footer>
    </blockquote>
    <p class="certificate-verify">
        Issued to <a href="https://github.com/@cert.Login">@@@cert.Login</a> on GitHub. This page is the proof:
        if it's at <span class="mono">@Model.VerifyUrl</span>, it's real.
    </p>
</article>

@if (Model.IsOwner)
{
    <section class="panel certificate-actions">
        <h2>Show it off</h2>
        <p>
            <a class="button" href="@CertificateRules.LinkedInUrl(cert, Model.VerifyUrl)" target="_blank" rel="noopener">Add to LinkedIn</a>
            <button type="button" class="secondary" id="copy-cert-link" data-url="@Model.VerifyUrl">Copy link</button>
            <a class="button secondary" href="/certificate">Change the name</a>
        </p>
        <p class="breakdown" id="copy-status" role="status"></p>
    </section>
    <script nonce="@ViewContext.HttpContext.CspNonce()">
        document.getElementById("copy-cert-link").addEventListener("click", async e => {
            await navigator.clipboard.writeText(e.currentTarget.dataset.url);
            document.getElementById("copy-status").textContent = "Link copied.";
        });
    </script>
}
