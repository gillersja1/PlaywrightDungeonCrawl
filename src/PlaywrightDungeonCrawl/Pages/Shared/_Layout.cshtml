@using PlaywrightDungeonCrawl.Dungeon
@inject DungeonCatalog Catalog
@inject IConfiguration Config
@{
    var accountsOn = Accounts.IsEnabled(Config);
    var player = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
    var language = Languages.Current(Context);
    // The docs for the language the player chose.
    var docsUrl = language == CodeLanguage.TypeScript ? "https://playwright.dev/docs/intro" : "https://playwright.dev/dotnet/docs/intro";
    var docsName = language == CodeLanguage.TypeScript ? "Playwright" : "Playwright for .NET";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Put the worn torch on before the page paints, so it doesn't flash the default color first. *@
    <script nonce="@Context.CspNonce()">
        (function () {
            const torches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Shop.Items.Where(i => i.Slot == LootSlot.Torch).ToDictionary(i => i.Id, i => new[] { i.Color, i.Dim })));
            try {
                const saved = JSON.parse(localStorage.getItem("pdc-progress")) || {};
                const id = saved.equipped && saved.equipped.torch;
                const colors = id && saved.loot && id in saved.loot && torches[id];
                if (colors) {
                    const root = document.documentElement;
                    root.dataset.torch = id;
                    root.style.setProperty("--torch", colors[0]);
                    root.style.setProperty("--torch-dim", colors[1]);
                    root.style.setProperty("--torch-bright", `color-mix(in srgb, ${colors[0]} 70%, white)`);
                }
            } catch { }
        })();
    </script>
    <title>@(ViewData["Title"] is string title ? $"{title} · Playwright Dungeon Crawl" : "Playwright Dungeon Crawl")</title>
    <meta name="description" content="Learn Playwright by crawling a dungeon: lessons, riddles and trap rooms you beat with tests in C# or TypeScript." />
    @* Link previews (LinkedIn, Slack, ...) need absolute URLs. *@
    <meta property="og:site_name" content="Playwright Dungeon Crawl" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@(ViewData["ShareTitle"] as string ?? ViewData["Title"] as string ?? "Playwright Dungeon Crawl")" />
    <meta property="og:description" content="A free game that teaches Playwright in C# or TypeScript: read a short lesson, answer a riddle, then write a real test to beat each trap room. Eight floors, a leaderboard and a certificate you can add to LinkedIn." />
    @* A new file name when the image changes: link previews are cached by image address. *@
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/brand/og-image-2.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Playwright Dungeon Crawl: learn Playwright in C# or TypeScript. Write real Playwright tests to beat trap rooms, floor by floor." />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <partial name="_Faro" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">⚔</span>
            <span>Playwright Dungeon Crawl</span>
        </a>
        <nav aria-label="Main">
            <a href="/">Respawn Room</a>
            <a href="/#treasure">Claim treasure</a>
            <a href="/leaderboard">Leaderboard</a>
            <partial name="_LanguageSwitch" />
            <a class="xp-badge" href="/#progress" id="xp-badge" aria-label="Your experience">0 XP</a>
            @if (player is not null)
            {
                <form class="account" method="post" action="/signout">
                    <span class="player" title="Signed in with GitHub">@@@player</span>
                    <button type="submit" class="link-button">Sign out</button>
                </form>
            }
            else if (accountsOn)
            {
                <a class="account" href="/signin?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Sign in with GitHub</a>
            }
        </nav>
    </header>

    <main id="main" class="page">
        @RenderBody()
    </main>

    <div class="torch-fx" aria-hidden="true">
        @for (var i = 0; i < 16; i++)
        {
            // Spread out, but the same on every page load, so nothing jumps when you navigate.
            <span style="--x: @((i * 37 + 11) % 100)%; --y: @((i * 53 + 7) % 90)%; --delay: -@((i * 1.7) % 9)s; --dur: @(6 + i % 5)s; --drift: @((i % 2 == 0 ? 1 : -1) * (10 + i * 3))px"></span>
        }
    </div>

    <footer class="site-footer">
        <p>A free, hands-on way to learn Playwright, in C# or TypeScript. Docs: <a href="@docsUrl">@docsName</a>. @(player is not null ? "Your progress is saved to your GitHub account." : accountsOn ? "Progress is saved in this browser. Sign in with GitHub to keep it everywhere." : "Progress is saved in this browser only.")</p>
        <p>
            <a href="/feedback?from=@Uri.EscapeDataString(Context.Request.Path.Value ?? "/")">Send feedback</a>
            · <a href="/report-a-bug?from=@Uri.EscapeDataString(Context.Request.Path.Value ?? "/")">Report a bug</a>
            · <a href="/hall-of-bugslayers">Hall of Bugslayers</a>
        </p>
    </footer>

    <script id="dungeon-rules" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        scroll = Rewards.Scroll,
        riddle = Rewards.Riddle,
        treasure = Rewards.Treasure,
        maxXp = DungeonCatalog.MaxXp(Catalog.Floors.Count),
        floors = Catalog.Floors.Select(f => new { number = f.Number, slug = f.Slug, room = f.Room.Slug, roomName = f.Room.Name, title = f.Title }),
        account = new { enabled = accountsOn, player },
        ranks = Rewards.RanksFor(DungeonCatalog.MaxXp(Catalog.Floors.Count)).Select(r => new { minXp = r.MinXp, title = r.Title }),
        shop = Shop.Items.Select(i => new { id = i.Id, slot = i.Slot.ToString().ToLowerInvariant(), name = i.Name, price = i.Price, color = i.Color, dim = i.Dim }),
    }))</script>
    <script src="~/js/progress.js" asp-append-version="true"></script>
    <script src="~/js/dungeon-ai.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
